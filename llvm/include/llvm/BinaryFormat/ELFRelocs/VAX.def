#ifndef ELF_RELOC
#error "ELF_RELOC must be defined"
#endif

// VAX ELF relocations (matching NetBSD sys/arch/vax/include/elf_machdep.h)
ELF_RELOC(R_VAX_NONE,    0)
ELF_RELOC(R_VAX_32,      1)
ELF_RELOC(R_VAX_16,      2)
ELF_RELOC(R_VAX_8,       3)
ELF_RELOC(R_VAX_PC32,    4)
ELF_RELOC(R_VAX_PC16,    5)
ELF_RELOC(R_VAX_PC8,     6)
ELF_RELOC(R_VAX_GOT32,   7)
ELF_RELOC(R_VAX_PLT32,   13)
ELF_RELOC(R_VAX_COPY,    19)
ELF_RELOC(R_VAX_GLOB_DAT, 20)
ELF_RELOC(R_VAX_JMP_SLOT, 21)
ELF_RELOC(R_VAX_RELATIVE, 22)
